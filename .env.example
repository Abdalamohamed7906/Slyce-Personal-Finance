# Copy this file to .env and fill in your own values. NEVER commit .env.

# Long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# How long a login lasts (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite database file
DATABASE_URL=sqlite:///./slyce.db

# Optional: LLM for personalised tips and stock summaries.
# Leave blank and the app uses simple built-in tips instead.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Optional: Trading 212 (use the DEMO / practice account key)
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_BASE_URL=https://demo.trading212.com/api/v0
